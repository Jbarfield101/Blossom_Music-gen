{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.blossom.musicgen",
  "productName": "Blossom Music Generator",
  "version": "0.6.5",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:5225"
  },
  "app": {
    "windows": [
      {
        "title": "Music Generator",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "allow-internal-toggle-devtools",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:webview:allow-internal-toggle-devtools"
          ]
        },
        {
          "identifier": "allow-path-resolve",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:path:default",
            "core:path:allow-resolve-directory"
          ]
        },
        {
          "identifier": "allow-fs-voice-models",
          "windows": [
            "*"
          ],
          "permissions": [
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$APPDATA/**"
                },
                {
                  "path": "$RESOURCE/assets/voice_models/**"
                },
                {
                  "path": "$RESOURCE/assets/agents/**"
                },
                {
                  "path": "$RESOURCE/models/**"
                },
                {
                  "path": "$APP/models/**"
                },
                {
                  "path": "$APP/assets/agents/**"
                },
                {
                  "path": "D:/Blossom/Blossom_Music/models/**"
                },
                {
                  "path": "D:/Blossom/Blossom_Music/assets/images/**"
                },
                {
                  "path": "D:/Blossom/Blossom_Music/assets/agents/**"
                },
                {
                  "path": "D:\\\\Blossom\\\\Blossom_Music\\\\assets\\\\images\\\\**"
                },
                {
                  "path": "D:\\\\Blossom\\\\Blossom_Music\\\\assets\\\\agents\\\\**"
                },
                {
                  "path": "d:/blossom/blossom_music/assets/images/**"
                },
                {
                  "path": "d:/blossom/blossom_music/assets/agents/**"
                },
                {
                  "path": "D:/Blossom/Blossom_Music/src-tauri/models/**"
                },
                {
                  "path": "D:/Documents/DreadHaven/**"
                },
                {
                  "path": "D:\\\\Documents\\\\DreadHaven\\\\**"
                },
                {
                  "path": "d:/documents/dreadhaven/**"
                },
                {
                  "path": "$RESOURCE/assets/workflows/**"
                }
              ]
            },
            "fs:allow-mkdir",
            "fs:allow-write-file",
            "fs:allow-write-text-file",
            "fs:allow-read-file",
            "fs:allow-read-text-file",
            "fs:allow-read-dir",
            "fs:allow-exists",
            "fs:allow-remove"
          ]
        },
        {
          "identifier": "allow-shell-piper",
          "windows": [
            "*"
          ],
          "permissions": [
            {
              "identifier": "shell:allow-execute",
              "allow": [
                {
                  "name": "piper",
                  "cmd": "piper",
                  "args": true
                },
                {
                  "name": "piper-voices",
                  "cmd": "piper-voices",
                  "args": true
                },
                {
                  "name": "piper-venv",
                  "cmd": "$APP/../.venv/Scripts/piper.exe",
                  "args": true
                }
              ]
            }
          ]
        },
        {
          "identifier": "allow-dialog-open",
          "windows": [
            "*"
          ],
          "permissions": [
            "dialog:allow-open",
            "dialog:default"
          ]
        },
        {
          "identifier": "allow-core-event",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:default"
          ]
        },
        {
          "identifier": "allow-store",
          "windows": [
            "*"
          ],
          "permissions": [
            "store:default",
            "core:resources:allow-close"
          ]
        }
      ]
    }
  },
  "bundle": {
    "resources": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
